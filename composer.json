{
  "name": "dozyanka/programlab-feedback-form",
  "description": "Secure feedback form for the PHP developer take-home assignment",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "ext-gd": "*",
    "ext-pdo_sqlite": "*",
    "phpmailer/phpmailer": "^6.10"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "allow-plugins": {}
  },
  "scripts": {
    "test": "@php tests/run.php",
    "lint": "@php -l public/index.php"
  }
}
