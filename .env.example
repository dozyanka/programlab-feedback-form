# Docker Compose uses APP_KEY from this .env file (if copied).
# Generate a secret for production with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_KEY=replace-with-a-random-secret

# For non-Docker PHP deployments, set these variables in your environment.
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_ENCRYPTION=          # tls, ssl, or empty (Mailpit only)
# MAIL_FROM_ADDRESS=noreply@example.com
# MAIL_FROM_NAME=Feedback Form
